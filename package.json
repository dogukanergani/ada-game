{
  "name": "ada",
  "private": true,
  "version": "0.2.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "balance": "npm run balance -w @ada/game-core --",
    "cli": "npm run cli -w @ada/server --",
    "server": "npm run start -w @ada/server",
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev -w @ada/client",
    "e2e": "npm run e2e -w @ada/client",
    "start": "npm run start -w @ada/server"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
