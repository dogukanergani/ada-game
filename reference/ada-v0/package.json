{
  "name": "ada",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev:server": "npm run dev -w @ada/server",
    "dev:client": "npm run dev -w @ada/client",
    "build": "npm run build -w @ada/client",
    "start": "npm run start -w @ada/server",
    "test": "npm run test -w @ada/game-core && npm run test -w @ada/server",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
